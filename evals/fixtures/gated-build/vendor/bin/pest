#!/bin/sh
# Stand-in for Pest in this fixture: no Composer install, no DDEV, no database.
# Runs tests/**/*Test.php with PHP only (see vendor/pest-lite.php). Run it from the
# project root: vendor/bin/pest [--filter=<name>] [<file>...]
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
cd "$root" || exit 2
exec php "$root/vendor/pest-lite.php" "$@"
