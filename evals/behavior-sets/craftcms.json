      ["project-config/diff", "project-config/write"]
    ],
    "facts": [{"file": "skills/craftcms/SKILL.md", "contains": ["`project-config/write` empties `config/project/`", "Run `craft up` first"]}, {"file": "skills/craftcms/references/deployment.md", "contains": ["git diff --stat -- config/project"]}]
  },
